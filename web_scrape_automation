class SessionPool:
    """
    One requests.Session per worker thread, each with its own cookie jar and
    user agent. Cookies matter: the gateway rejects requests that have not
    first been through the site and picked up an Akamai session.
    """

    def __init__(self, proxy: Optional[str], timeout: float, verbose: bool = False):
        self._local = threading.local()
        self._proxy = proxy
        self._timeout = timeout
        self._verbose = verbose

    @property
    def session(self):
        session = getattr(self._local, "session", None)
        if session is None:
            session = self._build()
            self._local.session = session
        return session

    def _build(self):
        use_cffi = USE_CURL_CFFI and CURL_CFFI_AVAILABLE
        proxies = (
            {"http": self._proxy, "https": self._proxy} if self._proxy else None
        )

        if use_cffi:
            kwargs = {"impersonate": IMPERSONATE}
            if proxies:
                kwargs["proxies"] = proxies
            session = curl_requests.Session(**kwargs)
            # curl_cffi supplies its own browser-consistent user-agent and
            # header ordering; overriding those defeats the impersonation.
        else:
            session = requests.Session()
            session.headers.update(
                {
                    "user-agent": random.choice(USER_AGENTS),
                    "accept-language": "en-US,en;q=0.9",
                    "accept-encoding": "gzip, deflate, br",
                }
            )
            if proxies:
                session.proxies.update(proxies)

        self._warm(session)
        return session

    def _warm(self, session) -> None:
        """Acquire cookies by loading the homepage before touching the API."""
        try:
            response = session.get(
                f"{BASE_URL}/",
                headers=html_headers(),
                timeout=self._timeout,
                allow_redirects=True,
            )
            if self._verbose:
                print(
                    f"    [warm] homepage -> HTTP {response.status_code}, "
                    f"{len(session.cookies)} cookies",
                    file=sys.stderr,
                )
        except HTTP_ERRORS as exc:
            if self._verbose:
                print(f"    [warm] failed: {exc}", file=sys.stderr)

    def reset(self) -> None:
        """Discard this thread's session after a block and build a fresh one."""
        session = getattr(self._local, "session", None)
        if session is not None:
            try:
                session.close()
            except Exception:
                pass
        self._local.session = None


def html_headers() -> Dict[str, str]:
    return {
        "accept": (
            "text/html,application/xhtml+xml,application/xml;q=0.9,"
            "image/avif,image/webp,*/*;q=0.8"
        ),
        "sec-fetch-dest": "document",
        "sec-fetch-mode": "navigate",
        "sec-fetch-site": "none",
        "sec-fetch-user": "?1",
        "upgrade-insecure-requests": "1",
    }


def graphql_headers() -> Dict[str, str]:
    return {
        "accept": "application/json",
        "content-type": "application/json",
        "origin": BASE_URL,
        "referer": f"{BASE_URL}/",
        "apollographql-client-name": "general-merchandise",
        "apollographql-client-version": "0.0.0",
        "x-experience-name": "general-merchandise",
        "x-hd-dc": "origin",
        "x-current-url": "/",
        "sec-fetch-dest": "empty",
        "sec-fetch-mode": "cors",
        "sec-fetch-site": "same-origin",
    }


def looks_blocked(response: "requests.Response") -> bool:
    if response.status_code in (401, 403, 429):
        return True
    if response.status_code == 200:
        head = response.text[:2000].lower()
        for marker in ("access denied", "reference #", "pardon our interruption",
                       "bot detection", "_abck"):
            if marker in head and "<html" in head:
                return True
    return False


