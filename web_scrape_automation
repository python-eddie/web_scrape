def absolutize(url: str) -> str:
    if not url:
        return ""
    if url.startswith("http://") or url.startswith("https://"):
        return url
    if not url.startswith("/"):
        url = "/" + url
    return BASE_URL + url


def _dump_debug(label: str, response: "requests.Response") -> None:
    """Append a raw response to debug_response.txt when DEBUG_DUMP is on."""
    global _DEBUG_WRITES
    if not DEBUG_DUMP or _DEBUG_WRITES >= 8:
        return
    with _VARIANT_LOCK:
        if _DEBUG_WRITES >= 8:
            return
        _DEBUG_WRITES += 1
        try:
            with open("debug_response.txt", "a", encoding="utf-8") as handle:
                handle.write("=" * 70 + "\n")
                handle.write(f"{label}\nHTTP {response.status_code}\n")
                handle.write(f"content-type: {response.headers.get('content-type')}\n")
                handle.write("-" * 70 + "\n")
                handle.write(response.text[:4000] + "\n\n")
        except OSError:
            pass


def _graphql_attempt(
    session: "requests.Session", omsid: str, timeout: float, variant_index: int
) -> Tuple[LookupResult, bool]:
    """
    Run one query variant.

    Returns (result, definitive). "definitive" is False only when the response
    was clean but the product came back null, which is the ambiguous case that
    justifies trying another variant.
    """
    name, query, build_vars = QUERY_VARIANTS[variant_index]
    result = LookupResult(omsid=omsid, method=f"GRAPHQL[{name}]")
    payload = {
        "operationName": GRAPHQL_OPNAME,
        "variables": build_vars(omsid),
        "query": query,
    }
    try:
        response = session.post(
            GRAPHQL_URL,
            params={"opname": GRAPHQL_OPNAME},
            json=payload,
            headers=graphql_headers(),
            timeout=timeout,
        )
    except HTTP_ERRORS as exc:
        result.status = STATUS_ERROR
        result.note = f"request failed: {type(exc).__name__}: {exc}"
        return result, True

    result.http_status = response.status_code
    _dump_debug(f"{omsid} variant={name}", response)

    if looks_blocked(response):
        result.status = STATUS_BLOCKED
        result.note = f"bot management response (HTTP {response.status_code})"
        return result, True

    if response.status_code >= 500:
        result.status = STATUS_ERROR
        result.note = f"server error HTTP {response.status_code}"
        return result, True

    try:
        body = response.json()
    except ValueError:
        result.status = STATUS_ERROR
        result.note = f"response was not JSON (HTTP {response.status_code})"
        return result, True

    if body.get("errors"):
        messages = "; ".join(
            str(err.get("message", err))[:160] for err in body["errors"][:3]
        )
        result.status = STATUS_ERROR
        result.note = f"graphql errors: {messages}"
        # A schema rejection is definitive for THIS variant but not for others.
        return result, False

    product = (body.get("data") or {}).get("product")
    if not product:
        result.status = STATUS_NOT_FOUND
        result.note = f"null product (variant={name})"
        return result, False

    identifiers = product.get("identifiers") or {}
    canonical = absolutize(identifiers.get("canonicalUrl") or "")
    if not canonical:
        canonical = f"{BASE_URL}/p/x/{omsid}"
        result.note = "canonicalUrl absent; URL rebuilt from itemId"

    result.status = STATUS_LIVE
    result.url = canonical
    result.product_name = identifiers.get("productLabel") or ""
    result.brand = identifiers.get("brandName") or ""
    result.model_number = identifiers.get("modelNumber") or ""
    result.store_sku = identifiers.get("storeSkuNumber") or ""
    return result, True


def graphql_lookup(
    session: "requests.Session", omsid: str, timeout: float
) -> LookupResult:
    """
    Try query variants until one gives a definitive answer. Once a variant
    returns a live product, it is remembered and tried first from then on.
    """
    global _PREFERRED_VARIANT

    order = list(range(len(QUERY_VARIANTS)))
    if _PREFERRED_VARIANT is not None:
        order.remove(_PREFERRED_VARIANT)
        order.insert(0, _PREFERRED_VARIANT)
        # A known-good variant is trusted; do not spend requests on the rest.
        order = order[:1]

    last = LookupResult(omsid=omsid, method="GRAPHQL", status=STATUS_ERROR,
                        note="no variant attempted")

    for index in order:
        result, definitive = _graphql_attempt(session, omsid, timeout, index)
        last = result

        if result.status == STATUS_LIVE:
            if _PREFERRED_VARIANT is None:
                with _VARIANT_LOCK:
                    if _PREFERRED_VARIANT is None:
                        _PREFERRED_VARIANT = index
                        print(
                            f"    [info] using GraphQL variant "
                            f"'{QUERY_VARIANTS[index][0]}' for this run",
                            file=sys.stderr,
                        )
            return result

        if definitive:
            return result

    return last


def redirect_lookup(
    session: "requests.Session", omsid: str, timeout: float
) -> LookupResult:
    result = LookupResult(omsid=omsid, method="REDIRECT")
    last_note = ""

    for template in REDIRECT_TEMPLATES:
        probe_url = template.format(omsid=omsid)
        try:
            response = session.get(
                probe_url,
                headers=html_headers(),
                timeout=timeout,
                allow_redirects=True,
            )
        except HTTP_ERRORS as exc:
            last_note = f"request failed: {type(exc).__name__}: {exc}"
            continue

        result.http_status = response.status_code

        if looks_blocked(response):
            result.status = STATUS_BLOCKED
            result.note = f"bot management response (HTTP {response.status_code})"
            return result

        if response.status_code == 404:
            last_note = "HTTP 404"
            continue

        if response.status_code >= 500:
            last_note = f"server error HTTP {response.status_code}"
            continue

        match = PDP_PATH_RE.search(response.url)
        if match and match.group(1) == omsid:
            result.status = STATUS_LIVE
            result.url = response.url.split("?")[0]
            result.product_name = extract_title(response.text)
            return result

        last_note = f"resolved to non-PDP URL: {response.url[:180]}"

    # Every template answered without a block and none produced a PDP for this
    # item id, so the site is telling us the OMSID is not live.
    result.status = STATUS_NOT_FOUND
    result.note = last_note or "no template resolved to a PDP"
    return result


TITLE_RE = re.compile(r"<title[^>]*>(.*?)</title>", re.IGNORECASE | re.DOTALL)


def extract_title(html: str) -> str:
    match = TITLE_RE.search(html or "")
    if not match:
        return ""
    title = re.sub(r"\s+", " ", match.group(1)).strip()
    for suffix in (" - The Home Depot", " | The Home Depot"):
        if title.endswith(suffix):
            title = title[: -len(suffix)]
    return title[:250]


