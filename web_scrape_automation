@dataclass
class Config:
    method: str = "auto"
    workers: int = 3
    delay: float = 1.0
    jitter: float = 0.75
    timeout: float = 25.0
    max_attempts: int = 3
    verbose: bool = False


def check_one(omsid: str, pool: SessionPool, cfg: Config) -> LookupResult:
    """
    Resolve a single OMSID, retrying transient failures and re-warming the
    session after a block.
    """
    methods: List[str]
    if cfg.method == "graphql":
        methods = ["graphql"]
    elif cfg.method == "redirect":
        methods = ["redirect"]
    else:
        methods = ["graphql", "redirect"]

    last_result = LookupResult(omsid=omsid, status=STATUS_ERROR, note="not attempted")
    attempts = 0

    for method in methods:
        for attempt in range(1, cfg.max_attempts + 1):
            attempts += 1
            time.sleep(cfg.delay + random.uniform(0, cfg.jitter))

            session = pool.session
            if method == "graphql":
                result = graphql_lookup(session, omsid, cfg.timeout)
            else:
                result = redirect_lookup(session, omsid, cfg.timeout)

            result.attempts = attempts
            last_result = result

            if result.status in TERMINAL_STATUSES:
                return result.stamp()

            if result.status == STATUS_BLOCKED:
                pool.reset()
                backoff = min(60.0, (2 ** attempt) + random.uniform(0, 3))
                if cfg.verbose:
                    print(
                        f"    [{omsid}] blocked on {method}; sleeping {backoff:.1f}s",
                        file=sys.stderr,
                    )
                time.sleep(backoff)
                continue

            # STATUS_ERROR -- short backoff, then retry the same method.
            time.sleep(min(20.0, 1.5 * attempt))

        if cfg.verbose:
            print(
                f"    [{omsid}] {method} exhausted ({last_result.status}: "
                f"{last_result.note[:100]})",
                file=sys.stderr,
            )

    return last_result.stamp()


class ResultCache:
    """Incremental JSON cache so a long run can be interrupted and resumed."""

    def __init__(self, path: Optional[Path], flush_every: int = 25):
        self.path = path
        self.flush_every = flush_every
        self._data: Dict[str, Dict[str, Any]] = {}
        self._lock = threading.Lock()
        self._since_flush = 0
        if path and path.exists():
            try:
                self._data = json.loads(path.read_text(encoding="utf-8"))
            except (ValueError, OSError):
                self._data = {}

    def get(self, omsid: str) -> Optional[LookupResult]:
        record = self._data.get(omsid)
        if not record:
            return None
        try:
            return LookupResult(**record)
        except TypeError:
            return None

    def put(self, result: LookupResult) -> None:
        if self.path is None:
            return
        with self._lock:
            self._data[result.omsid] = asdict(result)
            self._since_flush += 1
            if self._since_flush >= self.flush_every:
                self._flush_locked()

    def close(self) -> None:
        if self.path is None:
            return
        with self._lock:
            self._flush_locked()

    def _flush_locked(self) -> None:
        try:
            self.path.write_text(
                json.dumps(self._data, indent=2), encoding="utf-8"
            )
            self._since_flush = 0
        except OSError as exc:
            print(f"WARNING: could not write cache: {exc}", file=sys.stderr)


def run_lookups(
    omsids: List[str], cfg: Config, pool: SessionPool, cache: ResultCache,
    resume: bool
) -> Dict[str, LookupResult]:
    results: Dict[str, LookupResult] = {}
    pending: List[str] = []

    for omsid in omsids:
        cached = cache.get(omsid) if resume else None
        if cached and cached.status in TERMINAL_STATUSES:
            results[omsid] = cached
        else:
            pending.append(omsid)

    if resume and results:
        print(f"Resuming: {len(results)} OMSIDs already resolved from cache.")

    total = len(pending)
    if total == 0:
        return results

    print(f"Checking {total} unique OMSIDs with {cfg.workers} worker(s)...")
    completed = 0
    progress_lock = threading.Lock()

    with ThreadPoolExecutor(max_workers=cfg.workers) as executor:
        futures = {
            executor.submit(check_one, omsid, pool, cfg): omsid
            for omsid in pending
        }
        for future in as_completed(futures):
            omsid = futures[future]
            try:
                result = future.result()
            except Exception as exc:  # defensive; a worker should not raise
                result = LookupResult(
                    omsid=omsid,
                    status=STATUS_ERROR,
                    note=f"worker exception: {type(exc).__name__}: {exc}",
                ).stamp()
            results[omsid] = result
            cache.put(result)

            with progress_lock:
                completed += 1
                if completed % 10 == 0 or completed == total:
                    print(f"  {completed}/{total} checked", flush=True)

    cache.close()
    return results


