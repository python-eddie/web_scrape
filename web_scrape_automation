def normalize_omsid(raw: Any) -> Optional[str]:
    """
    Coerce a spreadsheet cell into a bare digit string.

    Handles the usual Excel indignities: numeric columns read back as floats
    ("205220341.0"), stray whitespace, leading apostrophes, and NaN.
    """
    if raw is None:
        return None
    if isinstance(raw, float):
        if pd.isna(raw):
            return None
        if float(raw).is_integer():
            raw = int(raw)
    text = str(raw).strip()
    if not text or text.lower() in {"nan", "none", "n/a", "na", "-", "null"}:
        return None
    text = re.sub(r"\.0+$", "", text)
    digits = re.sub(r"\D", "", text)
    if not digits:
        return None
    # Home Depot Internet numbers are 9 digits, but do not hard-fail on length;
    # flag it in the note instead so nothing is silently dropped.
    return digits


def detect_omsid_column(df: "pd.DataFrame") -> str:
    """
    Find the OMSID column by header name, then by content shape as a fallback.
    """
    lowered = {str(col).strip().lower(): col for col in df.columns}

    for candidate in CANDIDATE_HEADERS:
        if candidate in lowered:
            return lowered[candidate]

    for key, col in lowered.items():
        if any(candidate in key for candidate in CANDIDATE_HEADERS):
            return col

    # Content-based fallback: the column with the highest share of values that
    # normalize to 8-10 digit numbers.
    best_col, best_score = None, 0.0
    for col in df.columns:
        series = df[col].head(200)
        if series.empty:
            continue
        hits = sum(
            1
            for value in series
            if (norm := normalize_omsid(value)) and 8 <= len(norm) <= 10
        )
        score = hits / len(series)
        if score > best_score:
            best_col, best_score = col, score

    if best_col is not None and best_score >= 0.5:
        return best_col

    raise ValueError(
        "Could not identify an OMSID column. Pass one explicitly with --column. "
        f"Columns present: {list(df.columns)}"
    )


def load_input(
    path: Path, sheet: Optional[str], column: Optional[str]
) -> Tuple["pd.DataFrame", str]:
    """
    Read the workbook and return (dataframe, omsid_column_name).

    The full input is preserved, including duplicate OMSIDs and non-OMSID
    columns, so the output workbook is a superset of what you handed in.
    """
    sheet_arg: Any = 0 if sheet is None else sheet
    df = pd.read_excel(path, sheet_name=sheet_arg, dtype=object)

    if isinstance(df, dict):  # pandas returns a dict when sheet_name is None
        first_key = next(iter(df))
        df = df[first_key]

    if df.empty:
        raise ValueError(f"No rows found in {path} (sheet={sheet_arg!r}).")

    if column:
        if column not in df.columns:
            raise ValueError(
                f"Column {column!r} not present. Columns: {list(df.columns)}"
            )
        omsid_col = column
    else:
        omsid_col = detect_omsid_column(df)

    df = df.copy()
    # Build as a pure-Python object Series. Using .map() here would let pandas
    # coerce every None into NaN, and NaN is truthy -- an invalid row would then
    # be treated as a real OMSID downstream.
    df["_omsid_norm"] = pd.Series(
        [normalize_omsid(value) for value in df[omsid_col]],
        index=df.index,
        dtype=object,
    )
    return df, omsid_col


