def validate(omsids: List[str], cfg: Config, pool: SessionPool) -> int:
    """
    Probe every query variant against known OMSIDs and print raw diagnostics.
    Run this before committing to a large job.
    """
    print("=" * 78)
    print("VALIDATION MODE")
    print("=" * 78)

    session = pool.session
    print(f"Cookies acquired after warm-up: {len(session.cookies)}")
    if len(session.cookies) == 0:
        print("  WARNING: no cookies. The homepage request was blocked outright.")

    any_live = False
    any_blocked = False
    working_variant = None

    for omsid in omsids:
        print(f"\nOMSID {omsid}")
        print("-" * 46)

        for index, (name, _query, _vars) in enumerate(QUERY_VARIANTS):
            result, _definitive = _graphql_attempt(session, omsid, cfg.timeout, index)
            flag = "  <-- WORKS" if result.status == STATUS_LIVE else ""
            print(f"  variant {name:<22} status={result.status:<10} "
                  f"http={result.http_status}{flag}")
            if result.url and result.url != NOT_APPLICABLE:
                print(f"          {result.url}")
            if result.product_name:
                print(f"          {result.product_name[:80]}")
            if result.note and result.status != STATUS_LIVE:
                print(f"          note: {result.note[:150]}")

            if result.status == STATUS_LIVE:
                any_live = True
                if working_variant is None:
                    working_variant = name
                break
            if result.status == STATUS_BLOCKED:
                any_blocked = True

            time.sleep(cfg.delay + random.uniform(0, cfg.jitter))

        time.sleep(cfg.delay)

        red = redirect_lookup(session, omsid, cfg.timeout)
        print(f"  REDIRECT method        status={red.status:<10} "
              f"http={red.http_status}")
        if red.status == STATUS_BLOCKED:
            any_blocked = True

    print("\n" + "=" * 78)
    if any_live:
        print(f"RESULT: WORKING. Query variant '{working_variant}' returns live data.")
        print("        Set MODE = \"test\" at the top of this file and run again.")
        print("=" * 78)
        return 0

    if any_blocked:
        print("RESULT: BLOCKED. Bot management is rejecting requests from this IP.")
    else:
        print("RESULT: NO DATA. The API answered but returned null for every")
        print("        variant. Either these test OMSIDs are no longer live,")
        print("        or the query shape has changed again.")
        print("        Set DEBUG_DUMP = True and re-run to capture raw responses")
        print("        in debug_response.txt.")
    print("=" * 78)
    return 2


