BASE_URL = "https://www.homedepot.com"
GRAPHQL_URL = f"{BASE_URL}/federation-gateway/graphql"
GRAPHQL_OPNAME = "productClientOnlyProduct"

# Home Depot's product resolver has changed argument shape over time, and a
# missing argument yields a null product rather than an error. So several
# variants are defined and tried in order. The first one that returns a real
# product is remembered and used for the rest of the run, so this costs extra
# requests only during warm-up.

_FIELDS = """
    itemId
    identifiers {
      canonicalUrl
      brandName
      productLabel
      modelNumber
      storeSkuNumber
    }
"""

QUERY_VARIANTS = [
    (
        "store_and_datasource",
        """query productClientOnlyProduct($itemId: String!, $storeId: String, $zipCode: String, $dataSource: String) {
  product(itemId: $itemId, dataSource: $dataSource) {""" + _FIELDS + """  }
}""",
        lambda omsid: {
            "itemId": omsid,
            "storeId": STORE_ID,
            "zipCode": ZIP_CODE,
