OUTPUT_COLUMNS = [
    ("Status", "status", 12),
    ("URL", "url", 70),
    ("Product Name", "product_name", 45),
    ("Brand", "brand", 18),
    ("Model Number", "model_number", 20),
    ("Store SKU", "store_sku", 14),
