]

HEADER_FILL = PatternFill("solid", fgColor="1F3864")
HEADER_FONT = Font(name="Arial", size=10, bold=True, color="FFFFFF")
BODY_FONT = Font(name="Arial", size=10)
LINK_FONT = Font(name="Arial", size=10, color="0563C1", underline="single")

STATUS_FILLS = {
    STATUS_LIVE: PatternFill("solid", fgColor="E2EFDA"),
    STATUS_NOT_FOUND: PatternFill("solid", fgColor="F2F2F2"),
    STATUS_BLOCKED: PatternFill("solid", fgColor="FCE4D6"),
    STATUS_ERROR: PatternFill("solid", fgColor="FFF2CC"),
    STATUS_INVALID: PatternFill("solid", fgColor="FFD9D9"),
}


def coerce_for_excel(value: Any) -> Any:
    """
    openpyxl rejects numpy scalars and pandas NaT. Convert to native Python.
    """
    if value is None:
        return None
    if isinstance(value, float) and pd.isna(value):
        return None
    if value is pd.NaT:
        return None
    if isinstance(value, (str, int, float, bool, datetime)):
        return value
    if hasattr(value, "item"):  # numpy scalar
        try:
            return value.item()
        except Exception:
            pass
    if isinstance(value, pd.Timestamp):
        return value.to_pydatetime()
    return str(value)


def write_output(
    df: "pd.DataFrame",
    omsid_col: str,
    results: Dict[str, LookupResult],
    out_path: Path,
    cfg: Config,
    input_path: Path,
) -> Dict[str, int]:
    workbook = Workbook()
    sheet = workbook.active
    sheet.title = "Results"

    source_columns = [c for c in df.columns if c != "_omsid_norm"]
    headers = [str(c) for c in source_columns] + [h for h, _, _ in OUTPUT_COLUMNS]

    for col_idx, header in enumerate(headers, start=1):
        cell = sheet.cell(row=1, column=col_idx, value=header)
        cell.font = HEADER_FONT
        cell.fill = HEADER_FILL
        cell.alignment = Alignment(vertical="center", horizontal="left")

    counts: Dict[str, int] = {}

    for row_offset, (_, row) in enumerate(df.iterrows()):
        excel_row = row_offset + 2

        for col_idx, source_col in enumerate(source_columns, start=1):
            cell = sheet.cell(
                row=excel_row,
                column=col_idx,
                value=coerce_for_excel(row[source_col]),
            )
            cell.font = BODY_FONT

        normalized = row["_omsid_norm"]
        if not isinstance(normalized, str) or not normalized:
            result = LookupResult(
                omsid="",
                status=STATUS_INVALID,
                url=NOT_APPLICABLE,
                note="no usable OMSID in this row",
            )
        else:
            result = results.get(
                normalized,
                LookupResult(
                    omsid=normalized,
                    status=STATUS_ERROR,
                    note="not checked",
                ),
            )

        counts[result.status] = counts.get(result.status, 0) + 1

        base = len(source_columns)
        for offset, (_header, attr, _width) in enumerate(OUTPUT_COLUMNS, start=1):
            value = getattr(result, attr)
            if value is None or value == "":
                value = "" if attr != "url" else NOT_APPLICABLE
            cell = sheet.cell(row=excel_row, column=base + offset, value=value)
            cell.font = BODY_FONT

            if attr == "status":
                fill = STATUS_FILLS.get(result.status)
                if fill:
                    cell.fill = fill
            elif attr == "url" and result.status == STATUS_LIVE and value != NOT_APPLICABLE:
                cell.hyperlink = value
                cell.font = LINK_FONT

    # Column widths.
    for col_idx, source_col in enumerate(source_columns, start=1):
        width = max(12, min(40, len(str(source_col)) + 6))
        sheet.column_dimensions[get_column_letter(col_idx)].width = width
    base = len(source_columns)
    for offset, (_header, _attr, width) in enumerate(OUTPUT_COLUMNS, start=1):
        sheet.column_dimensions[get_column_letter(base + offset)].width = width

    sheet.freeze_panes = "A2"
    sheet.auto_filter.ref = (
        f"A1:{get_column_letter(len(headers))}{sheet.max_row}"
    )

    # Summary sheet.
    summary = workbook.create_sheet("Run Summary")
    summary_rows = [
        ("Input file", str(input_path)),
        ("OMSID column", str(omsid_col)),
        ("Total input rows", len(df)),
        ("Unique OMSIDs checked", len(results)),
        ("Method", cfg.method),
        ("Workers", cfg.workers),
        ("Delay (s)", cfg.delay),
        ("Run finished (UTC)",
         datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")),
        ("", ""),
        ("Status", "Row count"),
    ]
    for status in (STATUS_LIVE, STATUS_NOT_FOUND, STATUS_BLOCKED,
                   STATUS_ERROR, STATUS_INVALID):
        summary_rows.append((status, counts.get(status, 0)))
    summary_rows.extend(
        [
            ("", ""),
            ("Status meanings", ""),
            (STATUS_LIVE, "Item resolved to a live PDP; URL populated."),
            (STATUS_NOT_FOUND,
             "Absent from Home Depot's published sitemaps. USUALLY means not "
             "live, but coverage is imperfect -- treat as 'needs review', not "
             "'confirmed dead'. See the Needs Review sheet."),
            (STATUS_BLOCKED,
             "Bot management intercepted the request. NOT a dead item -- re-run."),
            (STATUS_ERROR,
             "Network or parse failure. NOT a dead item -- re-run."),
            (STATUS_INVALID, "The input row contained no usable OMSID."),
        ]
    )

    for row_idx, (label, value) in enumerate(summary_rows, start=1):
        left = summary.cell(row=row_idx, column=1, value=label)
        right = summary.cell(row=row_idx, column=2, value=value)
        left.font = Font(name="Arial", size=10, bold=True)
        right.font = BODY_FONT
    summary.column_dimensions["A"].width = 26
    summary.column_dimensions["B"].width = 72

    # Needs Review sheet: the NOT_FOUND rows, isolated for manual or API
    # verification. Sitemap coverage is imperfect, so these are candidates for
    # a second pass rather than confirmed-dead items.
    review = workbook.create_sheet("Needs Review")
    review_headers = ["OMSID", "Row in Results", "Verify URL", "Confirmed?",
                      "Notes"]
    for col_idx, header in enumerate(review_headers, start=1):
        cell = review.cell(row=1, column=col_idx, value=header)
        cell.font = HEADER_FONT
        cell.fill = HEADER_FILL

    review_row = 2
    for row_offset, (_, row) in enumerate(df.iterrows()):
        normalized = row["_omsid_norm"]
        if not isinstance(normalized, str) or not normalized:
            continue
        result = results.get(normalized)
        if not result or result.status != STATUS_NOT_FOUND:
            continue
        search_url = f"{BASE_URL}/s/{normalized}"
        values = [normalized, row_offset + 2, search_url, "", ""]
        for col_idx, value in enumerate(values, start=1):
            cell = review.cell(row=review_row, column=col_idx, value=value)
            cell.font = BODY_FONT
            if col_idx == 3:
                cell.hyperlink = search_url
                cell.font = LINK_FONT
        review_row += 1

    for letter, width in (("A", 14), ("B", 16), ("C", 46), ("D", 13), ("E", 44)):
        review.column_dimensions[letter].width = width
    review.freeze_panes = "A2"
    if review_row > 2:
        review.auto_filter.ref = f"A1:E{review_row - 1}"
    else:
        review.cell(row=2, column=1,
                    value="No NOT_FOUND rows -- nothing to review.").font = BODY_FONT

    out_path.parent.mkdir(parents=True, exist_ok=True)
    workbook.save(out_path)
    return counts


