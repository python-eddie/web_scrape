# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def log(message: str = "") -> None:
    if VERBOSE:
        print(message, flush=True)


def require(module_name: str, pip_name: Optional[str] = None):
    """Import a third-party module with a readable failure message."""
    try:
        return __import__(module_name)
    except ImportError:
        pip_name = pip_name or module_name
        print(
            f"\nMissing dependency: {pip_name}\n"
            f"In PyCharm go to File > Settings > Project > Python Interpreter, "
            f"press '+', search for '{pip_name}', and install it.\n",
            file=sys.stderr,
        )
        raise SystemExit(1)


def looks_gzipped(payload: bytes) -> bool:
    return len(payload) >= 2 and payload[0] == 0x1F and payload[1] == 0x8B


def decompress_if_needed(payload: bytes) -> bytes:
    """Home Depot serves some sitemap files gzipped under an .xml name."""
    if looks_gzipped(payload):
        try:
            return gzip.decompress(payload)
        except OSError:
            return payload
    return payload


def strip_bom(payload: bytes) -> bytes:
    if payload.startswith(b"\xef\xbb\xbf"):
        return payload[3:]
    return payload


# ---------------------------------------------------------------------------
# ID normalisation
# ---------------------------------------------------------------------------

def normalize_id(raw: object) -> Optional[str]:
    """
    Turn a spreadsheet cell into a clean digit string, or None if unusable.

    Handles the usual Excel damage: floats such as 1001015306.0, values stored
    as text with spaces or hyphens, and scientific notation.
    """
    if raw is None:
        return None

    if isinstance(raw, float):
        if raw != raw:                       # NaN
            return None
        if raw.is_integer():
            text = str(int(raw))
        else:
            text = repr(raw)
    elif isinstance(raw, int):
        text = str(raw)
    else:
        text = str(raw)

    text = text.strip()
    if not text or text.lower() in {"nan", "none", "n/a", "na", "-"}:
        return None

    # Scientific notation, for example 1.001015306E9
    if "e" in text.lower() and any(ch.isdigit() for ch in text):
        try:
            as_float = float(text)
            if as_float.is_integer():
                text = str(int(as_float))
        except ValueError:
            pass

    digits = re.sub(r"[^0-9]", "", text)
    if not digits:
        return None

    digits = digits.lstrip("0") or "0"
    if not (6 <= len(digits) <= 12):
        return None
    return digits


def classify_id(clean_id: str) -> str:
    """Best-effort guess at which catalogue an ID belongs to."""
    if len(clean_id) == 10 and clean_id.startswith("100"):
        return "CANADA"
    if len(clean_id) == 9:
        return "US_OMSID"
    if len(clean_id) == 10:
        return "CANADA_LIKELY"
    return "UNKNOWN"


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

def build_session():
    """
    Build the HTTP client.

    Home Depot's Akamai configuration inspects the TLS fingerprint. A plain
    Python client completes the handshake and is then disconnected before any
    HTTP response is sent, which surfaces as RemoteDisconnected or a read
    timeout rather than a status code. curl_cffi reproduces a real Chrome
    fingerprint and is served normally. This was confirmed by diagnostic:
    requests and urllib both failed, curl_cffi returned HTTP 200 in 0.13s.
    """
    engine = HTTP_ENGINE

    if engine in ("auto", "curl_cffi"):
        try:
            from curl_cffi import requests as cffi_requests
        except ImportError:
            if engine == "curl_cffi":
                print(
                    "\nHTTP_ENGINE is set to 'curl_cffi' but the library is not "
                    "installed.\nIn PyCharm: File > Settings > Project > Python "
                    "Interpreter > '+' > curl_cffi\n",
                    file=sys.stderr,
                )
                raise SystemExit(1)
            log("  curl_cffi is not installed, falling back to requests")
        else:
            profiles = [IMPERSONATE_PROFILE] + [
                p for p in IMPERSONATE_FALLBACKS if p != IMPERSONATE_PROFILE
            ]

            # curl_cffi accepts an unknown profile name at construction and
            # only rejects it when a request is made, so validate up front
            # against whatever this installed version actually supports.
            try:
                from curl_cffi.requests import BrowserType
                supported = {entry.value for entry in BrowserType}
            except Exception:                         # noqa: BLE001
                supported = set()

            if supported:
                valid = [p for p in profiles if p in supported]
                for skipped in (p for p in profiles if p not in supported):
                    log(f"  impersonation profile {skipped!r} is not available "
                        f"in this curl_cffi version, skipping")
                if not valid:
                    newest = sorted(
                        (p for p in supported if p.startswith("chrome") and p[6:].isdigit()),
                        key=lambda p: int(p[6:]),
                    )
                    valid = newest[-1:] or sorted(supported)[:1]
                    if valid:
                        log(f"  no configured profile is available, using {valid[0]!r}")
                profiles = valid

            last_error = None
            for profile in profiles:
                try:
                    session = cffi_requests.Session(impersonate=profile)
                    session.headers.update({
                        "Accept": "application/xml,text/xml,text/plain,*/*",
                        "Accept-Language": "en-CA,en;q=0.9,fr-CA;q=0.8",
                    })
                    session._hdca_engine = "curl_cffi"
                    session._hdca_profile = profile
                    log(f"  HTTP engine: curl_cffi, impersonating {profile}")
                    return session
                except Exception as exc:              # noqa: BLE001
                    last_error = exc
                    continue
            log(f"  curl_cffi could not start ({last_error}), falling back to requests")

    requests = require("requests")
    session = requests.Session()
    session.headers.update({
        "User-Agent": USER_AGENT,
        "Accept": "application/xml,text/xml,text/plain,*/*",
        "Accept-Language": "en-CA,en;q=0.9,fr-CA;q=0.8",
        "Accept-Encoding": "gzip, deflate",
        "Connection": "keep-alive",
    })
    session._hdca_engine = "requests"
    session._hdca_profile = None
    log("  HTTP engine: requests (no TLS impersonation)")
    return session


def classify_exception(exc: Exception) -> str:
    """Turn a transport exception into a short, readable note."""
    name = type(exc).__name__
    text = str(exc).lower()
    if "timed out" in text or "timeout" in text or name.endswith("Timeout"):
        return "timeout"
    if "closed connection" in text or "remotedisconnected" in text:
        return "connection closed by server (TLS fingerprint rejected?)"
    if "connection" in text or name.endswith("ConnectionError"):
        return f"connection error: {name}"
    return f"{name}: {exc}"


def fetch(session, url: str, timeout: float = REQUEST_TIMEOUT
          ) -> Tuple[Optional[bytes], int, str]:
    """
    Fetch a URL with retries. Works with either HTTP engine.

    Returns (payload_or_None, http_status, note). A payload is returned
    already decompressed and BOM-stripped.
    """
    last_note = ""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            response = session.get(url, timeout=timeout, allow_redirects=True)
            status = response.status_code
            if status == 200:
                payload = strip_bom(decompress_if_needed(response.content))
                return payload, status, ""
            if status in (404, 410):
                return None, status, "not found"
            if status in (429, 500, 502, 503, 504) and attempt < MAX_RETRIES:
                wait = RETRY_BACKOFF ** attempt
                last_note = f"HTTP {status}, retrying in {wait:.0f}s"
                log(f"      {last_note}")
                time.sleep(wait)
                continue
            return None, status, f"HTTP {status}"
        except Exception as exc:                      # noqa: BLE001
            last_note = classify_exception(exc)

        if attempt < MAX_RETRIES:
            wait = RETRY_BACKOFF ** attempt
            log(f"      {last_note}, retrying in {wait:.0f}s")
            time.sleep(wait)

    return None, 0, last_note or "failed"


# ---------------------------------------------------------------------------
# Sitemap parsing
# ---------------------------------------------------------------------------

def parse_sitemap(payload: bytes) -> Tuple[str, List[str]]:
    """
    Parse a sitemap document.

    Returns (kind, locations) where kind is "index", "urlset", or "unknown".
    Falls back to a regex sweep if the XML will not parse, which happens with
    truncated or slightly malformed files.
    """
    try:
        root = ET.fromstring(payload)
    except ET.ParseError:
        locations = [
            match.decode("utf-8", "replace")
            for match in re.findall(rb"<loc>\s*([^<]+?)\s*</loc>", payload)
        ]
        return ("unknown", locations) if locations else ("unknown", [])

    tag = root.tag.split("}")[-1].lower()
    locations: List[str] = []
    for element in root.iter():
        if element.tag.split("}")[-1].lower() == "loc" and element.text:
            locations.append(element.text.strip())

    if tag == "sitemapindex":
        return "index", locations
    if tag == "urlset":
        return "urlset", locations
    return "unknown", locations


def extract_product_id(url: str) -> Optional[str]:
    match = PRODUCT_URL_RE.search(url)
    if match:
        return match.group(1).lstrip("0") or "0"
    if "/product/" in url or "/produit/" in url:
        loose = LOOSE_ID_RE.search(url)
        if loose:
            return loose.group(1).lstrip("0") or "0"
    return None


def is_product_url(url: str) -> bool:
    return ("/product/" in url or "/produit/" in url) and extract_product_id(url) is not None


def language_of(url: str) -> str:
    return "fr" if "/produit/" in url.lower() else "en"


# ---------------------------------------------------------------------------
# Sitemap discovery
# ---------------------------------------------------------------------------

def sitemaps_from_robots(session) -> List[str]:
    payload, status, note = fetch(session, ROBOTS_URL)
    log(f"  robots.txt -> HTTP {status}{(' (' + note + ')') if note else ''}")
    if not payload:
        return []
    text = payload.decode("utf-8", "replace")
    found = re.findall(r"(?im)^\s*sitemap:\s*(\S+)\s*$", text)
    for url in found:
        log(f"    declared: {url}")
    return found


def expand_index(session, url: str, depth: int = 0, seen: Optional[Set[str]] = None
                 ) -> List[str]:
    """Walk a sitemap index down to the urlset files it points at."""
    seen = seen if seen is not None else set()
    if url in seen or depth > 3:
        return []
    seen.add(url)

    payload, status, _ = fetch(session, url)
    if not payload:
        return []
    kind, locations = parse_sitemap(payload)

    if kind == "urlset":
        return [url]

    results: List[str] = []
    for location in locations:
        if not location.lower().endswith((".xml", ".xml.gz")):
            continue
        results.extend(expand_index(session, location, depth + 1, seen))
        if len(results) >= SITEMAP_MAX_FILES:
            break
    return results


def enumerate_product_sitemaps(session, languages: Sequence[str]) -> List[str]:
    """
    Fall back to the known numbered file pattern.

    Verified to exist: sitemap_product_en.1.xml, sitemap_product_en.2.xml,
    sitemap_product_fr.1.xml, sitemap_product_fr.15.xml, and
    sitemap_product_fr.20.xml. The numbering starts at 1 and is contiguous,
    so the scan walks upward until it sees several misses in a row.
    """
    discovered: List[str] = []
    for lang in languages:
        misses = 0
        number = 1
        log(f"  enumerating {lang} product sitemaps")
        while number <= SITEMAP_MAX_FILES and misses < ENUMERATION_MISS_TOLERANCE:
            url = PRODUCT_SITEMAP_TEMPLATE.format(lang=lang, n=number)
            payload, status, _ = fetch(session, url)
            if payload:
                discovered.append(url)
                misses = 0
                log(f"    found {url.rsplit('/', 1)[-1]}  ({len(payload):,} bytes)")
            else:
                misses += 1
                log(f"    miss  {url.rsplit('/', 1)[-1]}  (HTTP {status})")
            number += 1
            time.sleep(REQUEST_DELAY)
    return discovered


def languages_wanted() -> List[str]:
    if LANGUAGE == "both":
        return ["en", "fr"]
    if LANGUAGE in ("en", "fr"):
        return [LANGUAGE]
    raise SystemExit(f'LANGUAGE must be "en", "fr", or "both", not {LANGUAGE!r}')


def discover_product_sitemaps(session) -> List[str]:
    """robots.txt, then candidate index paths, then numbered enumeration."""
    langs = languages_wanted()
    log("\nDiscovering Home Depot Canada sitemaps")

    candidates: List[str] = []
    for url in sitemaps_from_robots(session):
        candidates.extend(expand_index(session, url))

    if not candidates:
        log("  robots.txt gave nothing usable, trying common index paths")
        for path in CANDIDATE_INDEX_PATHS:
            found = expand_index(session, BASE + path)
            if found:
                log(f"    {path} -> {len(found)} sitemap file(s)")
                candidates.extend(found)
                break
            log(f"    {path} -> nothing")

    product_files = [
        url for url in candidates
        if "product" in url.lower() or "produit" in url.lower()
    ]
    if product_files:
        wanted = []
        for url in product_files:
            lowered = url.lower()
            if any(f"_{lang}." in lowered or f"_{lang}/" in lowered for lang in langs):
                wanted.append(url)
        chosen = wanted or product_files
        log(f"  index route produced {len(chosen)} product sitemap file(s)")
        return chosen[:SITEMAP_MAX_FILES]

    log("  falling back to the known numbered file pattern")
    return enumerate_product_sitemaps(session, langs)


# ---------------------------------------------------------------------------
# Index building
# ---------------------------------------------------------------------------

@dataclass
class SitemapIndex:
    en: Dict[str, str] = field(default_factory=dict)
    fr: Dict[str, str] = field(default_factory=dict)
    files_read: int = 0
    urls_seen: int = 0
    complete: bool = False          # unfiltered crawl that read every file
    exhausted: bool = False         # the crawl reached the end of the file list
    searched: Set[str] = field(default_factory=set)  # IDs this crawl looked for
    language: str = "en"
    built_at: str = ""

    def get(self, product_id: str) -> Tuple[Optional[str], Optional[str]]:
        return self.en.get(product_id), self.fr.get(product_id)

    def known_ids(self) -> Set[str]:
        return set(self.en) | set(self.fr)

    def to_dict(self) -> dict:
        return {
            "version": 2,
            "en": self.en,
            "fr": self.fr,
            "files_read": self.files_read,
            "urls_seen": self.urls_seen,
            "complete": self.complete,
            "exhausted": self.exhausted,
            "searched": sorted(self.searched),
            "language": self.language,
            "built_at": self.built_at,
        }

    @classmethod
    def from_dict(cls, data: dict) -> "SitemapIndex":
        return cls(
            en=dict(data.get("en", {})),
            fr=dict(data.get("fr", {})),
            files_read=int(data.get("files_read", 0)),
            urls_seen=int(data.get("urls_seen", 0)),
            complete=bool(data.get("complete", False)),
            exhausted=bool(data.get("exhausted", False)),
            searched=set(data.get("searched", [])),
            language=str(data.get("language", "en")),
            built_at=str(data.get("built_at", "")),
        )


def load_cached_index(path: Path) -> Optional[SitemapIndex]:
    if SITEMAP_REBUILD or not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        index = SitemapIndex.from_dict(data)
        log(f"\nLoaded cached index: {len(index.known_ids()):,} product IDs "
            f"(built {index.built_at or 'unknown'}, "
            f"{'complete crawl' if index.complete else 'partial crawl'})")
        return index
    except Exception as exc:                          # noqa: BLE001
        log(f"  cache unreadable ({type(exc).__name__}), rebuilding")
        return None


def cache_is_usable(index: SitemapIndex, wanted: Set[str]) -> bool:
    """
    Decide whether a cached index can answer this input without re-crawling.

    Three cases count as an answer:
      1. The crawl was unfiltered and read every file, so it covers everything.
      2. Every wanted ID was matched, so nothing is left to look for.
      3. The crawl read every file while looking for a superset of these IDs.
         Anything it did not match is a confirmed absence, not a crawl artefact.

    Case 3 matters in practice: without it, a single genuinely dead item would
    force a full re-crawl on every run.
    """
    if index.language != LANGUAGE:
        log(f"  cached index was built for LANGUAGE={index.language!r}, rebuilding")
        return False
    if index.complete:
        return True
    if not (wanted - index.known_ids()):
        return True
    if index.exhausted and not (wanted - index.searched):
        log("  cached index read every sitemap file for these IDs, "
            "so unmatched ones are confirmed absent")
        return True

    unexplained = wanted - index.known_ids() - (
        index.searched if index.exhausted else set()
    )
    log(f"  cached index cannot account for {len(unexplained):,} of your IDs, rebuilding")
    return False


def build_index(session, wanted: Optional[Set[str]]) -> SitemapIndex:
    index = SitemapIndex(
        built_at=datetime.now().isoformat(timespec="seconds"),
        searched=set(wanted) if wanted else set(),
        language=LANGUAGE,
    )
    files = discover_product_sitemaps(session)

    if not files:
        log("\nNo product sitemap files could be reached. Nothing to match against.")
        return index

    log(f"\nReading {len(files)} product sitemap file(s)")
    target = len(wanted) if wanted else None
    stopped_early = False

    for position, url in enumerate(files, start=1):
        payload, status, note = fetch(session, url)
        if not payload:
            log(f"  [{position}/{len(files)}] {url.rsplit('/', 1)[-1]} -> "
                f"HTTP {status} {note}, skipped")
            continue

        kind, locations = parse_sitemap(payload)
        index.files_read += 1
        matched_here = 0

        for location in locations:
            product_id = extract_product_id(location)
            if not product_id:
                continue
            index.urls_seen += 1
            if wanted is not None and product_id not in wanted:
                continue
            if language_of(location) == "fr":
                index.fr.setdefault(product_id, location)
            else:
                index.en.setdefault(product_id, location)
            matched_here += 1

        found_total = len(index.known_ids())
        progress = f" | {found_total:,}/{target:,} matched" if target else ""
        log(f"  [{position}/{len(files)}] {url.rsplit('/', 1)[-1]} -> {kind}, "
            f"{len(locations):,} locs, {matched_here:,} kept{progress}")

        if (wanted is not None and STOP_WHEN_ALL_FOUND
                and target and found_total >= target):
            log("  every requested ID has been located, stopping early")
            stopped_early = True
            break

        time.sleep(REQUEST_DELAY)

    index.exhausted = not stopped_early
    index.complete = (wanted is None) and index.exhausted
    return index


def save_index(index: SitemapIndex, path: Path) -> None:
    try:
        path.write_text(json.dumps(index.to_dict()), encoding="utf-8")
        log(f"\nIndex cached to {path.resolve()}")
    except Exception as exc:                          # noqa: BLE001
        log(f"\nCould not write cache ({type(exc).__name__}: {exc}). Continuing.")


