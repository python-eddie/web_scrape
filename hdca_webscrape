def mode_diagnose() -> int:
    """Inspect the input file only. No network access."""
    path = Path(INPUT_FILE)
    frame = read_input(path)
    column = detect_id_column(frame)
    per_row, unique = collect_ids(frame, column)

    log(f"\nFile      : {path.resolve()}")
    log(f"Rows      : {len(frame):,}")
    log(f"Columns   : {list(frame.columns)}")
    log(f"ID column : {column!r}")
    log(f"Readable  : {sum(1 for value in per_row if value):,} of {len(per_row):,}")
    log(f"Unique    : {len(unique):,}")

    kinds: Dict[str, int] = {}
    for value in unique:
        kind = classify_id(value)
        kinds[kind] = kinds.get(kind, 0) + 1

    log("\nID shape breakdown")
    for kind, count in sorted(kinds.items(), key=lambda item: -item[1]):
        share = 100.0 * count / max(len(unique), 1)
        log(f"  {kind:<14} {count:>7,}  ({share:5.1f}%)")

    sample = sorted(unique)[:8]
    log(f"\nSample IDs: {', '.join(sample) if sample else 'none'}")

    us_share = kinds.get("US_OMSID", 0) / max(len(unique), 1)
    if us_share > 0.5:
        log(
            "\nWARNING: most of these look like US OMSIDs, which are 9 digits.\n"
            "Home Depot Canada uses a separate 10-digit catalogue. Running the\n"
            "Canadian match against US numbers will return NOT_FOUND for almost\n"
            "every row. Confirm you are working from Canadian item IDs first."
        )
    else:
        log("\nThese look consistent with Home Depot Canada product IDs.")
    return 0


def mode_sitemap_test() -> int:
    """Confirm the Canadian sitemaps are reachable and parse correctly."""
    session = build_session()
    log("Testing reachability of Home Depot Canada's sitemaps")

    files = discover_product_sitemaps(session)
    if not files:
        engine = getattr(session, "_hdca_engine", "unknown")
        log(
            f"\nFAILED. No product sitemap files responded. HTTP engine: {engine}.\n"
        )
        if engine != "curl_cffi":
            log(
                "You are not using TLS impersonation. Home Depot's Akamai layer\n"
                "closes plain Python connections without sending a response, which\n"
                "looks like a timeout rather than a block. Install curl_cffi:\n"
                "  File > Settings > Project > Python Interpreter > '+' > curl_cffi\n"
                "then run this again."
            )
        else:
            log(
                "curl_cffi is active, so the fingerprint is not the issue. Try a\n"
                "different IMPERSONATE_PROFILE from IMPERSONATE_FALLBACKS, and\n"
                "confirm https://www.homedepot.ca/robots.txt still loads in Chrome\n"
                "on this machine."
            )
        return 2

    log(f"\nDiscovered {len(files)} product sitemap file(s). Sampling the first one.")
    payload, status, note = fetch(session, files[0])
    if not payload:
        log(f"  first file returned HTTP {status} {note}")
        return 2

    kind, locations = parse_sitemap(payload)
    products = [url for url in locations if is_product_url(url)]
    log(f"  {files[0]}")
    log(f"  -> {kind}, {len(locations):,} locations, {len(products):,} product URLs")

    if not products:
        log("\nThe file parsed but held no product URLs. Send me this output.")
        return 2

    log("\nSample product URLs and the IDs parsed from them:")
    for url in products[:5]:
        log(f"  {extract_product_id(url):<12} {url}")

    log(
        f"\nSUCCESS. Set MODE = \"sitemap\" and press Run again.\n"
        f"Estimated catalogue coverage: roughly {len(products):,} products per "
        f"file across {len(files)} files."
    )
    return 0


def run_match(audit: bool = False) -> int:
    path = Path(INPUT_FILE)
    frame = read_input(path)
    column = detect_id_column(frame)
    per_row, unique = collect_ids(frame, column)

    log(f"\nInput      : {path.resolve()}")
    log(f"ID column  : {column!r}")
    log(f"Rows       : {len(frame):,}")
    log(f"Unique IDs : {len(unique):,}")

    if not unique:
        log("\nNo readable product IDs. Run MODE = \"diagnose\" to see why.")
        return 1

    canadian = sum(1 for value in unique
                   if classify_id(value) in ("CANADA", "CANADA_LIKELY"))
    if canadian / len(unique) < 0.5:
        log(
            "\nWARNING: fewer than half of these IDs look Canadian. Home Depot\n"
            "Canada uses 10-digit IDs beginning 100. Continuing anyway, but\n"
            "expect a high NOT_FOUND count if these are US OMSIDs."
        )

    cache_path = Path(SITEMAP_CACHE_FILE)
    wanted: Optional[Set[str]] = unique if FILTER_TO_INPUT else None

    engine_used = "cached index, no requests made"
    index = load_cached_index(cache_path)
    if index is None or not cache_is_usable(index, unique):
        session = build_session()
        engine_used = getattr(session, "_hdca_engine", "unknown")
        profile = getattr(session, "_hdca_profile", None)
        if profile:
            engine_used = f"{engine_used} ({profile})"
        index = build_index(session, wanted)
        if not index.known_ids() and index.files_read == 0:
            log("\nNo sitemap data was retrieved. Run MODE = \"sitemap_test\" first.")
            return 2
        save_index(index, cache_path)

    results: List[RowResult] = []
    for offset, clean_id in enumerate(per_row):
        raw = frame.iloc[offset][column]
        if not clean_id:
            results.append(RowResult(
                raw=raw, clean_id=None, status=STATUS_INVALID,
                note="cell could not be read as a product ID",
            ))
            continue

        url_en, url_fr = index.get(clean_id)
        primary = url_en if LANGUAGE != "fr" else url_fr
        secondary = url_fr

        if primary or (LANGUAGE == "both" and secondary):
            results.append(RowResult(
                raw=raw, clean_id=clean_id, status=STATUS_LIVE,
                url_en=url_en or NOT_APPLICABLE,
                url_fr=url_fr or NOT_APPLICABLE,
                note="" if primary else "only the other language was published",
            ))
        else:
            note = "not present in Home Depot Canada's published sitemaps"
            if classify_id(clean_id) == "US_OMSID":
                note += "; this looks like a US OMSID, not a Canadian ID"
            results.append(RowResult(
                raw=raw, clean_id=clean_id, status=STATUS_NOT_FOUND, note=note,
            ))

    meta = {
        "input_file": str(path.resolve()),
        "sheet": "first sheet" if INPUT_SHEET is None else INPUT_SHEET,
        "id_column": column,
        "row_count": len(frame),
        "unique_ids": len(unique),
        "files_read": index.files_read,
        "urls_seen": index.urls_seen,
        "cache_file": str(cache_path.resolve()),
        "http_engine": engine_used,
        "complete": index.complete,
        "exhausted": index.exhausted,
    }

    out_path = Path(OUTPUT_FILE)
    counts = write_output(frame, column, results, out_path, meta)

    log("\n" + "-" * 62)
    for status in (STATUS_LIVE, STATUS_NOT_FOUND, STATUS_INVALID):
        log(f"  {status:<12} {counts.get(status, 0):>7,}")
    log("-" * 62)
    log(f"\nWorkbook written to: {out_path.resolve()}")

    if audit:
        unmatched = sorted({r.clean_id for r in results
                            if r.status == STATUS_NOT_FOUND and r.clean_id})
        log(f"\nAudit: {len(unmatched):,} unmatched ID(s)")
        for value in unmatched:
            log(f"  {value}  ->  {BASE}/search?q={value}")

    log(
        "\nNOT_FOUND means the ID is absent from Home Depot Canada's published\n"
        "sitemaps. That is strong evidence the item is not live, but sitemaps\n"
        "regenerate on a cycle, so spot-check a few before acting on them.\n"
        "The Needs Review tab has clickable search links for exactly that."
    )
    return 0


def mode_spotcheck() -> int:
    """Request a few resolved product URLs directly. Informational only."""
    cache_path = Path(SITEMAP_CACHE_FILE)
    index = load_cached_index(cache_path)
    if index is None:
        log("\nNo cached index. Run MODE = \"sitemap\" first.")
        return 1

    urls = list(index.en.values())[:SPOTCHECK_COUNT] or \
           list(index.fr.values())[:SPOTCHECK_COUNT]
    if not urls:
        log("\nThe cached index holds no URLs.")
        return 1

    session = build_session()
    session.headers["Accept"] = (
        "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
    )

    log("\nRequesting product pages directly. This is a bot-defence probe,")
    log("not a correctness check. A 403 does not mean the URL is wrong.\n")
    for url in urls:
        payload, status, note = fetch(session, url, timeout=30.0)
        size = len(payload) if payload else 0
        log(f"  HTTP {status:<4} {size:>8,} bytes  {url}")
        time.sleep(REQUEST_DELAY)

    log(
        "\nIf these returned 403, that is expected and harmless. The sitemap\n"
        "route does not depend on product pages being fetchable."
    )
    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> int:
    log("=" * 62)
    log("  Home Depot Canada product ID checker")
    log(f"  MODE = {MODE!r}   LANGUAGE = {LANGUAGE!r}")
    log("=" * 62)

    dispatch = {
        "diagnose": mode_diagnose,
        "sitemap_test": mode_sitemap_test,
        "sitemap": lambda: run_match(audit=False),
        "audit": lambda: run_match(audit=True),
        "spotcheck": mode_spotcheck,
    }

    handler = dispatch.get(MODE)
    if handler is None:
        log(f"\nUnknown MODE {MODE!r}. Valid values: {', '.join(sorted(dispatch))}")
        return 1
    return handler()


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nInterrupted.", file=sys.stderr)
        raise SystemExit(130)
