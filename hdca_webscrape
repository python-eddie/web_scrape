HTTP_ENGINE = "auto"             # "auto", "curl_cffi", or "requests"
IMPERSONATE_PROFILE = "chrome124"
IMPERSONATE_FALLBACKS = ("chrome131", "chrome120", "chrome110", "chrome116")

REQUEST_TIMEOUT = 60.0
REQUEST_DELAY = 0.35             # polite pause between file downloads, seconds
MAX_RETRIES = 3
RETRY_BACKOFF = 2.0

# "spotcheck" mode only: how many resolved URLs to request directly.
SPOTCHECK_COUNT = 3

VERBOSE = True

# ===========================================================================
# END OF CONFIGURATION
# ===========================================================================

BASE = "https://www.homedepot.ca"
ROBOTS_URL = f"{BASE}/robots.txt"

CANDIDATE_INDEX_PATHS = (
    "/sitemap.xml",
    "/sitemap_index.xml",
    "/sitemap-index.xml",
    "/sitemap_index_en.xml",
)

PRODUCT_SITEMAP_TEMPLATE = BASE + "/sitemap_product_{lang}.{n}.xml"

SITEMAP_NS = {"sm": "http://www.sitemaps.org/schemas/sitemap/0.9"}

# /product/<slug>/<id> or /produit/<slug>/<id>, with optional .html and slash.
PRODUCT_URL_RE = re.compile(
    r"/(?:product|produit)/[^/]+/(\d{6,12})(?:\.html)?/?$",
    re.IGNORECASE,
)
# Lenient fallback: any homedepot.ca URL ending in a run of digits.
LOOSE_ID_RE = re.compile(r"/(\d{6,12})(?:\.html)?/?$")

USER_AGENT = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"
)

