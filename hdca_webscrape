def read_input(path: Path):
    pandas = require("pandas")
    require("openpyxl")

    if not path.exists():
        raise SystemExit(
            f"\nInput file not found: {path.resolve()}\n"
            f"Put the workbook in the same folder as this script, or change "
            f"INPUT_FILE at the top."
        )

    sheet = 0 if INPUT_SHEET is None else INPUT_SHEET
    frame = pandas.read_excel(path, sheet_name=sheet, dtype=object)
    if frame.empty:
        raise SystemExit(f"\n{path.name} has no rows.")
    return frame


def detect_id_column(frame) -> str:
    """Pick the column holding the product IDs."""
    if ID_COLUMN is not None:
        if isinstance(ID_COLUMN, int):
            return str(frame.columns[ID_COLUMN])
        if ID_COLUMN in frame.columns:
            return str(ID_COLUMN)
        raise SystemExit(
            f"\nID_COLUMN {ID_COLUMN!r} is not in the file. "
            f"Columns present: {list(frame.columns)}"
        )

    headers = {str(col).strip().lower(): str(col) for col in frame.columns}
    for hint in ID_HEADER_HINTS:
        for lowered, original in headers.items():
            if lowered == hint:
                return original
    for hint in ID_HEADER_HINTS:
        for lowered, original in headers.items():
            if hint in lowered:
                return original

    # No helpful header. Score each column by how many cells normalise cleanly.
    best_column, best_score = None, 0.0
    for column in frame.columns:
        values = frame[column].tolist()
        usable = sum(1 for value in values if normalize_id(value))
        score = usable / max(len(values), 1)
        if score > best_score:
            best_column, best_score = column, score

    if best_column is None or best_score < 0.5:
        raise SystemExit(
            f"\nCould not identify the product ID column.\n"
            f"Columns present: {list(frame.columns)}\n"
            f"Set ID_COLUMN at the top of the script to the correct header."
        )
    return str(best_column)


def collect_ids(frame, column: str) -> Tuple[List[Optional[str]], Set[str]]:
    per_row = [normalize_id(value) for value in frame[column].tolist()]
    unique = {value for value in per_row if value}
    return per_row, unique


