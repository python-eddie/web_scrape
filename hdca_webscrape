INPUT_FILE = "Book11.xlsx"
OUTPUT_FILE = "results_homedepot_ca.xlsx"

MODE = "sitemap"

# Which language's URLs to return.
#   "en"   English URLs only            (/product/...)
#   "fr"   French URLs only             (/produit/...)
#   "both" English URL plus a second column holding the French URL
