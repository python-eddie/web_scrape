# Column in the Excel file holding the product IDs.
# None means auto-detect. Set to a header name or a zero-based number to force it.
ID_COLUMN: Optional[object] = None

# Sheet to read. None means the first sheet.
INPUT_SHEET: Optional[object] = None

# The index is cached to disk so later runs are fast.
