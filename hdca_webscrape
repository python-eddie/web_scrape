@dataclass
class RowResult:
    raw: object
    clean_id: Optional[str]
    status: str
    url_en: str = NOT_APPLICABLE
    url_fr: str = NOT_APPLICABLE
    note: str = ""


def write_output(frame, column: str, results: List[RowResult],
                 out_path: Path, meta: dict) -> Dict[str, int]:
    openpyxl = require("openpyxl")
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
    from openpyxl.utils import get_column_letter

    header_font = Font(name="Arial", size=11, bold=True, color="FFFFFF")
    header_fill = PatternFill("solid", fgColor="F96302")   # Home Depot orange
    body_font = Font(name="Arial", size=10)
    link_font = Font(name="Arial", size=10, color="0563C1", underline="single")
    thin = Side(style="thin", color="D9D9D9")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    status_fills = {
        STATUS_LIVE: PatternFill("solid", fgColor="E2EFDA"),
        STATUS_NOT_FOUND: PatternFill("solid", fgColor="FCE4D6"),
        STATUS_INVALID: PatternFill("solid", fgColor="F2F2F2"),
    }

    workbook = openpyxl.Workbook()

    # ---------------- Results ----------------
    sheet = workbook.active
    sheet.title = "Results"

    source_columns = [str(col) for col in frame.columns]
    added = ["Status", "URL (EN)"]
    if LANGUAGE in ("fr", "both"):
        added.append("URL (FR)")
    added += ["Clean ID", "Note", "Checked At"]
    headers = source_columns + added

    for position, name in enumerate(headers, start=1):
        cell = sheet.cell(row=1, column=position, value=name)
        cell.font = header_font
        cell.fill = header_fill
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border = border

    checked_at = datetime.now().strftime("%Y-%m-%d %H:%M")
    counts: Dict[str, int] = {}

    for offset, result in enumerate(results):
        row = offset + 2
        counts[result.status] = counts.get(result.status, 0) + 1

        for position, source in enumerate(source_columns, start=1):
            value = frame.iloc[offset][source]
            if value != value:                        # NaN
                value = None
            cell = sheet.cell(row=row, column=position, value=value)
            cell.font = body_font
            cell.border = border

        cursor = len(source_columns) + 1

        status_cell = sheet.cell(row=row, column=cursor, value=result.status)
        status_cell.font = Font(name="Arial", size=10, bold=True)
        status_cell.fill = status_fills.get(result.status, status_fills[STATUS_INVALID])
        status_cell.border = border
        status_cell.alignment = Alignment(horizontal="center")
        cursor += 1

        for url in ([result.url_en, result.url_fr]
                    if LANGUAGE in ("fr", "both") else [result.url_en]):
            cell = sheet.cell(row=row, column=cursor, value=url)
            if url and url != NOT_APPLICABLE:
                cell.hyperlink = url
                cell.font = link_font
            else:
                cell.font = body_font
            cell.border = border
            cursor += 1

        for value in (result.clean_id or NOT_APPLICABLE, result.note, checked_at):
            cell = sheet.cell(row=row, column=cursor, value=value)
            cell.font = body_font
            cell.border = border
            cursor += 1

    widths = {"Status": 12, "URL (EN)": 72, "URL (FR)": 72,
              "Clean ID": 14, "Note": 46, "Checked At": 17}
    for position, name in enumerate(headers, start=1):
        letter = get_column_letter(position)
        sheet.column_dimensions[letter].width = widths.get(name, 20)

    sheet.freeze_panes = "A2"
    sheet.auto_filter.ref = f"A1:{get_column_letter(len(headers))}{len(results) + 1}"

    # ---------------- Needs Review ----------------
    review = workbook.create_sheet("Needs Review")
    review_headers = ["Row in source", "ID as supplied", "Clean ID",
                      "Status", "Note", "Search Home Depot Canada"]
    for position, name in enumerate(review_headers, start=1):
        cell = review.cell(row=1, column=position, value=name)
        cell.font = header_font
        cell.fill = header_fill
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border = border

    review_row = 2
    for offset, result in enumerate(results):
        if result.status == STATUS_LIVE:
            continue
        search_url = (
            f"{BASE}/search?q={result.clean_id}"
            if result.clean_id else f"{BASE}/en/home.html"
        )
        values = [
            offset + 2,
            result.raw if result.raw == result.raw else None,
            result.clean_id or NOT_APPLICABLE,
            result.status,
            result.note,
            search_url,
        ]
        for position, value in enumerate(values, start=1):
            cell = review.cell(row=review_row, column=position, value=value)
            cell.font = body_font
            cell.border = border
        link_cell = review.cell(row=review_row, column=len(values))
        link_cell.hyperlink = search_url
        link_cell.font = link_font
        review_row += 1

    for position, width in enumerate([14, 20, 14, 13, 46, 60], start=1):
        review.column_dimensions[get_column_letter(position)].width = width
    review.freeze_panes = "A2"
    if review_row > 2:
        review.auto_filter.ref = f"A1:F{review_row - 1}"

    # ---------------- Run Info ----------------
    info = workbook.create_sheet("Run Info")
    info_rows = [
        ("Run at", checked_at),
        ("Source file", meta.get("input_file", "")),
        ("Sheet", str(meta.get("sheet", "first"))),
        ("ID column detected", meta.get("id_column", "")),
        ("Language", LANGUAGE),
        ("Rows in file", meta.get("row_count", 0)),
        ("Unique IDs", meta.get("unique_ids", 0)),
        ("Sitemap files read", meta.get("files_read", 0)),
        ("Product URLs scanned", meta.get("urls_seen", 0)),
        ("Index cache", meta.get("cache_file", "")),
        ("HTTP engine", meta.get("http_engine", "")),
        ("Read every sitemap file",
         "Yes" if meta.get("exhausted") else "No, the crawl stopped early once "
         "every requested ID was located"),
        ("Full catalogue indexed",
         "Yes" if meta.get("complete") else "No, only the IDs from this file "
         "were retained (FILTER_TO_INPUT is on)"),
        ("", ""),
        ("LIVE", counts.get(STATUS_LIVE, 0)),
        ("NOT_FOUND", counts.get(STATUS_NOT_FOUND, 0)),
        ("INVALID_ID", counts.get(STATUS_INVALID, 0)),
        ("", ""),
        ("What NOT_FOUND means",
         "The ID is absent from Home Depot Canada's published sitemaps. That is "
         "strong evidence the item is not live, but sitemaps regenerate on a "
         "cycle, so a very recently listed item can be live and still missing "
         "here. Spot-check these in a browser before acting on them."),
        ("What INVALID_ID means",
         "The cell could not be read as a product ID at all: blank, text, or "
         "the wrong number of digits."),
        ("Canadian versus US IDs",
         "Home Depot Canada product IDs are normally 10 digits beginning 100, "
         "for example 1001015306. US OMSIDs are normally 9 digits. The two "
         "catalogues do not share numbering."),
    ]
    for position, (label, value) in enumerate(info_rows, start=1):
        label_cell = info.cell(row=position, column=1, value=label)
        label_cell.font = Font(name="Arial", size=10, bold=True)
        value_cell = info.cell(row=position, column=2, value=value)
        value_cell.font = body_font
        value_cell.alignment = Alignment(wrap_text=True, vertical="top")
    info.column_dimensions["A"].width = 26
    info.column_dimensions["B"].width = 95

    workbook.save(out_path)
    return counts


