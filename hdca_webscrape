SITEMAP_REBUILD = False          # True forces a fresh download

# Keep only the IDs present in your input file. Uses far less memory and
# lets the crawl stop early once every ID is accounted for.
FILTER_TO_INPUT = True
STOP_WHEN_ALL_FOUND = True

# Safety caps on the crawl.
SITEMAP_MAX_FILES = 300          # hard ceiling on product sitemap files
ENUMERATION_MISS_TOLERANCE = 3   # consecutive 404s before enumeration stops

# Network behaviour.
#
# Home Depot's Akamai layer inspects the TLS fingerprint and disconnects
# clients that do not look like a browser, before sending any HTTP response.
# curl_cffi presents a real Chrome fingerprint and is served normally, so it
