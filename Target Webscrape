# ==========================================================================
# GENERAL HELPERS
# ==========================================================================

def parse_tcins(raw: str) -> list[str]:
    """Extract TCINs, keep input order, drop duplicates."""
    seen, out = set(), []
    for t in re.findall(r"\d+", raw):
        if t not in seen:
            seen.add(t)
            out.append(t)
    return out


def new_session() -> requests.Session:
    s = requests.Session()
    s.headers.update(HEADERS)
    return s


def find_key(obj, key):
    """Return the first value for `key` anywhere in a nested dict/list."""
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for v in obj.values():
            found = find_key(v, key)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for v in obj:
            found = find_key(v, key)
            if found is not None:
                return found
    return None


def get_parent_tcin(product: dict):
    direct = find_key(product, "parent_tcin")
    if direct:
        return direct
    parent = find_key(product, "parent")
    if isinstance(parent, dict):
        return parent.get("tcin")
    return None


# ==========================================================================
# SITEMAP MODE
# ==========================================================================

def fetch_xml(session: requests.Session, url: str) -> bytes | None:
    """Download a sitemap file; transparently gunzip .gz content."""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            r = session.get(url, headers=PAGE_HEADERS, timeout=TIMEOUT)
        except requests.RequestException as e:
            print(f"   request error on {url}: {type(e).__name__}")
            time.sleep(2 ** attempt)
            continue
        if r.status_code != 200:
            print(f"   HTTP {r.status_code} on {url}")
            if r.status_code in (429,) or r.status_code >= 500:
                time.sleep(2 ** attempt + random.random())
                continue
            return None
        body = r.content
        if body[:2] == b"\x1f\x8b":          # gzip magic bytes
            try:
                body = gzip.decompress(body)
            except OSError:
                print(f"   could not decompress {url}")
                return None
        return body
    return None


def xml_locs(body: bytes) -> list[str]:
    """Return every <loc> value in a sitemap or sitemap index."""
    try:
        root = ET.fromstring(body)
    except ET.ParseError:
        # Fallback for malformed XML.
        return re.findall(r"<loc>\s*(.*?)\s*</loc>", body.decode("utf-8", "replace"))
    return [el.text.strip() for el in root.iter() if el.tag.endswith("loc") and el.text]


def build_sitemap_index(tcins: list[str]) -> dict[str, str]:
    """Build {tcin: url} from Target's product sitemap, with disk caching."""
    if not SITEMAP_REBUILD and os.path.exists(SITEMAP_INDEX_FILE):
        with open(SITEMAP_INDEX_FILE, encoding="utf-8") as f:
            cached = json.load(f)
        print(f"Loaded cached sitemap index: {len(cached):,} entries.")
        return cached

    wanted = set(tcins) if SITEMAP_FILTER_TO_INPUT else None
    session = new_session()
    index: dict[str, str] = {}

    print(f"Downloading sitemap index: {SITEMAP_INDEX_URL}")
    root_body = fetch_xml(session, SITEMAP_INDEX_URL)
    if root_body is None:
        print("Could not download the sitemap index.")
        return index

    queue = xml_locs(root_body)
    print(f"{len(queue):,} sitemap files listed.")
    files_done = 0

    while queue and files_done < SITEMAP_MAX_FILES:
        url = queue.pop(0)
        body = fetch_xml(session, url)
        files_done += 1
        if body is None:
            continue

        locs = xml_locs(body)
        # A nested index lists more sitemap files rather than product URLs.
        if b"<sitemapindex" in body[:500]:
            queue.extend(locs)
            continue

        for loc in locs:
            m = TCIN_URL_RE.search(loc)
            if not m:
                continue
            tcin = m.group(1)
            if wanted is None or tcin in wanted:
                index.setdefault(tcin, loc)

        found = len(index) if wanted is None else len(wanted & index.keys())
        print(f"   [{files_done}] {url.rsplit('/', 1)[-1]}  "
              f"{'indexed' if wanted is None else 'matched'}: {found:,}")

        if wanted is not None and wanted <= index.keys():
            print("All input TCINs found; stopping early.")
            break

        time.sleep(random.uniform(0.2, 0.6))

    with open(SITEMAP_INDEX_FILE, "w", encoding="utf-8") as f:
        json.dump(index, f)
    print(f"Sitemap index saved to {SITEMAP_INDEX_FILE} ({len(index):,} entries).")
    return index


def sitemap_lookup(tcins: list[str]) -> dict[str, dict]:
    index = build_sitemap_index(tcins)
    results = {}
    for t in tcins:
        url = index.get(t)
        if url:
            results[t] = {"tcin": t, "status": "LIVE", "url": url, "method": "SITEMAP",
                          "note": "Found in sitemap_pdp-index"}
        else:
            results[t] = {"tcin": t, "status": "NOT_FOUND", "method": "SITEMAP",
                          "note": "Not in sitemap_pdp-index"}
    return results


# ==========================================================================
# API MODE (with product-page fallback)
# ==========================================================================

def refresh_api_key(session: requests.Session) -> str | None:
    """Read the current RedSky key from the target.com homepage HTML."""
    try:
        r = session.get("https://www.target.com/", headers=PAGE_HEADERS, timeout=TIMEOUT)
        for p in (r'"apiKey"\s*:\s*"([0-9a-f]{40})"',
                  r'\\"apiKey\\"\s*:\s*\\"([0-9a-f]{40})\\"',
                  r"[?&]key=([0-9a-f]{40})"):
            m = re.search(p, r.text)
            if m:
                return m.group(1)
    except requests.RequestException:
        pass
    return None


def check_api(session: requests.Session, tcin: str, api_key: str) -> dict:
    params = {"key": api_key, "tcin": tcin, "pricing_store_id": STORE_ID,
              "store_id": STORE_ID, "has_pricing_store_id": "true"}
    last_note = ""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            r = session.get(PDP_API_URL, params=params, timeout=TIMEOUT)
        except requests.RequestException as e:
            last_note = f"API request error: {type(e).__name__}"
            time.sleep(2 ** attempt)
            continue

        if r.status_code == 404:
            return {"status": "NOT_FOUND", "method": "API", "http": 404,
                    "note": "API returned 404"}
        if r.status_code in (401, 403):
            return {"status": "UNKNOWN", "method": "API", "http": r.status_code,
                    "note": "API key rejected or request blocked", "key_problem": True}
        if r.status_code == 429 or r.status_code >= 500:
            last_note = f"API HTTP {r.status_code}"
            time.sleep(2 ** attempt + random.random())
            continue

        try:
            data = r.json()
        except ValueError:
            last_note = f"API HTTP {r.status_code}, non-JSON response"
            time.sleep(2 ** attempt)
            continue

        product = (data.get("data") or {}).get("product")
        errors = data.get("errors") or []
        err_text = " | ".join(str(e.get("message", e)) if isinstance(e, dict) else str(e)
                              for e in errors if e)

        if product:
            title = find_key(product, "title")
            if title:
                return {
                    "status": "LIVE", "method": "API", "http": r.status_code,
                    "title": title,
                    # buy_url is Target's canonical PDP URL. If it is missing,
                    # the url is resolved from the page in check_tcin().
                    "url": find_key(product, "buy_url"),
                    "price": find_key(product, "formatted_current_price"),
                    "relationship_type": find_key(product, "relationship_type_code"),
                    "parent_tcin": get_parent_tcin(product),
                    "out_of_stock_all_stores": find_key(product, "is_out_of_stock_in_all_store_locations"),
                    "note": err_text,
                }
            last_note = "API product record had no title"
            break

        if errors and re.search(r"no product found|not found", err_text, re.I):
            return {"status": "NOT_FOUND", "method": "API", "http": r.status_code,
                    "note": err_text[:300]}

        last_note = f"API HTTP {r.status_code}, no product. {err_text[:200]}"
        break

    return {"status": "UNKNOWN", "method": "API", "note": last_note}


def check_page(session: requests.Session, tcin: str) -> dict:
    """
    Fallback: request the product page.

    Lesson from the HD script: the probe URL /p/-/A-<TCIN> contains the TCIN
    itself, so "final URL contains the TCIN" proves nothing when the site does
    not redirect. Here the TCIN must appear in the page's own canonical link
    (or og:url), which Target only renders for a real product page.
    """
    url = PDP_PAGE_URL.format(tcin=tcin)
    note = ""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            r = session.get(url, headers=PAGE_HEADERS, timeout=TIMEOUT, allow_redirects=True)
        except requests.RequestException as e:
            note = f"Page request error: {type(e).__name__}"
            time.sleep(2 ** attempt)
            continue

        # Status checks come before any URL matching.
        if r.status_code in (404, 410):
            return {"status": "NOT_FOUND", "method": "PAGE", "http": r.status_code,
                    "note": f"PDP returned {r.status_code}"}
        if r.status_code in (403, 429) or r.status_code >= 500:
            note = f"Page HTTP {r.status_code}"
            time.sleep(2 ** attempt + random.random())
            continue
        if r.status_code != 200:
            return {"status": "UNKNOWN", "method": "PAGE", "http": r.status_code,
                    "note": f"Page HTTP {r.status_code}"}

        html = r.text
        canon = (re.search(r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)', html, re.I)
                 or re.search(r'<meta[^>]+property=["\']og:url["\'][^>]+content=["\']([^"\']+)', html, re.I))
        canon_url = canon.group(1) if canon else ""
        m = TCIN_URL_RE.search(canon_url)

        title_m = re.search(r"<title>(.*?)</title>", html, re.S | re.I)
        title = re.sub(r"\s*:\s*Target\s*$", "", title_m.group(1).strip()) if title_m else None

        if m and m.group(1) == tcin and "/p/-/" not in canon_url:
            return {"status": "LIVE", "method": "PAGE", "http": 200,
                    "title": title, "url": canon_url}
        if m and m.group(1) != tcin:
            return {"status": "LIVE", "method": "PAGE", "http": 200, "title": title,
                    "url": canon_url, "parent_tcin": m.group(1),
                    "note": "Page canonicalizes to a different TCIN (likely the variation parent)"}
        return {"status": "NOT_FOUND", "method": "PAGE", "http": 200, "url": r.url,
                "note": f"No product canonical URL on page. Title: {title}"}

    return {"status": "UNKNOWN", "method": "PAGE", "note": note}


def check_tcin(tcin: str, api_key: str) -> dict:
    session = new_session()
    time.sleep(random.uniform(*DELAY_RANGE))
    result = check_api(session, tcin, api_key)
    if result["status"] == "UNKNOWN":
        page_result = check_page(session, tcin)
        if page_result["status"] != "UNKNOWN":
            page_result["note"] = (f"API inconclusive ({result.get('note', '')}); "
                                   + page_result.get("note", "")).strip("; ")
            result = page_result
        else:
            result["note"] = f"{result.get('note', '')} | {page_result.get('note', '')}"
    # A LIVE item must leave with a real URL. If the API did not supply one,
    # read the canonical URL from the product page.
    if result["status"] == "LIVE" and not result.get("url"):
        page_result = check_page(session, tcin)
        if page_result.get("status") == "LIVE" and page_result.get("url"):
            result["url"] = page_result["url"]
        else:
            result["note"] = (result.get("note", "") + " | URL not supplied by API "
                              "and could not be read from the page").strip(" |")
    result.pop("key_problem", None)
    result["tcin"] = tcin
    return result


def api_lookup(tcins: list[str]) -> dict[str, dict]:
    if not tcins:
        return {}
    api_key = API_KEY
    probe = check_api(new_session(), tcins[0], api_key)
    if probe.get("key_problem"):
        print("Hard-coded API key rejected. Reading the current key from target.com ...")
        fresh = refresh_api_key(new_session())
        if fresh:
            api_key = fresh
            print(f"Using refreshed key: {api_key}")
        else:
            print("Could not refresh the key. Page fallback will be used.")

    results = {}
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        futures = {pool.submit(check_tcin, t, api_key): t for t in tcins}
        for i, fut in enumerate(as_completed(futures), 1):
            t = futures[fut]
            try:
                res = fut.result()
            except Exception as e:
                res = {"tcin": t, "status": "UNKNOWN", "note": f"Unhandled: {e!r}"}
            results[t] = res
            print(f"   [{i}/{len(tcins)}] {t}: {res['status']}  {res.get('url') or ''}")
    return results


# ==========================================================================
# MAIN
# ==========================================================================

def main():
    tcins = parse_tcins(TCINS_RAW)
    print(f"{len(tcins)} unique TCINs. MODE = {MODE!r}\n")

    if MODE == "sitemap":
        results = sitemap_lookup(tcins)
    elif MODE == "api":
        results = api_lookup(tcins)
    elif MODE == "combined":
        results = sitemap_lookup(tcins)
        misses = [t for t in tcins if results[t]["status"] != "LIVE"]
        print(f"\nSitemap: {len(tcins) - len(misses)} LIVE, {len(misses)} not in sitemap.")
        if misses:
            print(f"Checking the {len(misses)} sitemap misses with the API ...")
            results.update(api_lookup(misses))
    else:
        raise ValueError('MODE must be "sitemap", "api", or "combined".')

    # In combined mode, an API row with no URL can borrow the sitemap URL.
    if MODE == "combined" and os.path.exists(SITEMAP_INDEX_FILE):
        with open(SITEMAP_INDEX_FILE, encoding="utf-8") as f:
            sm = json.load(f)
        for t in tcins:
            if results[t]["status"] == "LIVE" and not results[t].get("url") and sm.get(t):
                results[t]["url"] = sm[t]

    df = build_dataframe(tcins, results)
    xlsx_path = export_to_excel(df)

    missing_url = df.loc[(df["status"] == "LIVE") & (df["url"] == ""), "tcin"].tolist()
    if missing_url:
        print(f"\n{len(missing_url)} LIVE TCIN(s) without a URL: {', '.join(missing_url)}")

    print("\nSummary")
    print(df.groupby(["status", "method"], dropna=False).size().to_string())

    unknown = df.loc[df["status"] == "UNKNOWN", "tcin"].tolist()
    if unknown:
        print(f"\n{len(unknown)} TCIN(s) UNKNOWN. Re-run with MODE = 'api' or check by hand:")
        print(", ".join(unknown))

    print(f"\nExcel file saved:\n{xlsx_path}")
    if OPEN_EXCEL_WHEN_DONE:
        open_file(xlsx_path)


