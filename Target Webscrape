def build_dataframe(tcins: list[str], results: dict[str, dict]) -> pd.DataFrame:
    """One row per input TCIN, in input order, with a fixed column set."""
    rows = [results.get(t, {"tcin": t, "status": "UNKNOWN", "note": "Not checked"})
            for t in tcins]
    df = pd.DataFrame(rows).reindex(columns=COLUMNS)
    df["tcin"] = df["tcin"].astype(str)
    df["url"] = df["url"].fillna("")
    df["note"] = df["note"].fillna("")
    return df


def output_path() -> str:
    """Build the output file path. Defaults to the folder this script is in."""
    folder = OUTPUT_FOLDER or os.path.dirname(os.path.abspath(__file__))
    os.makedirs(folder, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    return os.path.join(folder, f"{OUTPUT_FILE_PREFIX}_{stamp}.xlsx")


def export_to_excel(df: pd.DataFrame) -> str:
    """
    Write the results workbook:
      Results  one row per TCIN; clickable URLs; status color-coded;
               header frozen; filters on every column.
      Summary  counts by status and by status + method.
    Returns the absolute path of the saved file.
    """
    from openpyxl.styles import Font, PatternFill, Alignment
    from openpyxl.utils import get_column_letter

    path = output_path()
    out = df.rename(columns=HEADER_LABELS)

    summary_status = (df["status"].value_counts()
                      .reindex(["LIVE", "NOT_FOUND", "UNKNOWN"], fill_value=0)
                      .rename_axis("Status").reset_index(name="Count"))
    summary_detail = (df.groupby(["status", "method"], dropna=False).size()
                      .reset_index(name="Count")
                      .rename(columns={"status": "Status", "method": "Method"}))

    def write(p: str):
        with pd.ExcelWriter(p, engine="openpyxl") as writer:
            out.to_excel(writer, index=False, sheet_name="Results")
            summary_status.to_excel(writer, index=False, sheet_name="Summary", startrow=0)
            summary_detail.to_excel(writer, index=False, sheet_name="Summary",
                                    startrow=len(summary_status) + 3)

            # ---- Results sheet formatting ----
            ws = writer.sheets["Results"]
            header_font = Font(bold=True, color="FFFFFF")
            header_fill = PatternFill("solid", fgColor="CC0000")   # Target red
            for cell in ws[1]:
                cell.font = header_font
                cell.fill = header_fill
                cell.alignment = Alignment(vertical="center", wrap_text=True)

            for i, col in enumerate(COLUMNS, start=1):
                ws.column_dimensions[get_column_letter(i)].width = COLUMN_WIDTHS[col]

            url_idx = COLUMNS.index("url") + 1
            status_idx = COLUMNS.index("status") + 1
            for r in range(2, len(df) + 2):
                # TCIN as text so Excel does not convert it to a number.
                ws.cell(row=r, column=1).number_format = "@"

                url_cell = ws.cell(row=r, column=url_idx)
                if url_cell.value:
                    url_cell.hyperlink = url_cell.value
                    url_cell.style = "Hyperlink"

                status_cell = ws.cell(row=r, column=status_idx)
                color = STATUS_FILL.get(status_cell.value)
                if color:
                    status_cell.fill = PatternFill("solid", fgColor=color)

            ws.freeze_panes = "A2"
            ws.auto_filter.ref = ws.dimensions

            # ---- Summary sheet formatting ----
            ss = writer.sheets["Summary"]
            ss.column_dimensions["A"].width = 14
            ss.column_dimensions["B"].width = 12
            ss.column_dimensions["C"].width = 10
            for row in (1, len(summary_status) + 4):
                for cell in ss[row]:
                    if cell.value is not None:
                        cell.font = Font(bold=True)

    try:
        write(path)
    except PermissionError:
        # Usually means a file with this name is open in Excel.
        alt = path.replace(".xlsx", "_1.xlsx")
        print(f"Could not write {path} (is it open in Excel?). Saving as {alt}")
        write(alt)
        path = alt
    return os.path.abspath(path)


def open_file(path: str):
    """Open the workbook in the default app (Excel on Windows/Mac)."""
    try:
        if os.name == "nt":
            os.startfile(path)                       # Windows
        elif sys.platform == "darwin":
            subprocess.run(["open", path], check=False)
        else:
            subprocess.run(["xdg-open", path], check=False)
    except Exception as e:
        print(f"Could not open the file automatically: {e}")


if __name__ == "__main__":
    main()
